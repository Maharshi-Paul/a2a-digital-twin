# ==============================================================================
# Warehouse A2A Digital Twin — Monorepo Root Environment Configuration
# ==============================================================================

DOMAIN=warehouse

# Database: Local PostgreSQL or Managed Neon / Supabase
# Supports both direct and pooled (PgBouncer) connection strings.
DATABASE_URL=postgresql+asyncpg://wdt_user:wdt_pass@localhost:5432/warehouse_twin
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_STATEMENT_CACHE_SIZE=0

# Redis: Local Redis or Managed Upstash / Render Key Value Store
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# API & Networking
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=

# Queue Engine & Simulation
QUEUE_TICK_SECONDS=10.0
QUEUE_ENGINE_MODE=rule_based
QUEUE_ENGINE_IDLE_WHEN_EMPTY=true
SIMULATION_SEED=42
SIMULATION_LAMBDA=3.0

# Optional LLM Features (Default is "none" - runs fully without any API key)
LLM_PROVIDER=none
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite

# Frontend environment variables (placed in frontend/.env.local for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
