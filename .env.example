DOMAIN=warehouse
DATABASE_URL=postgresql+asyncpg://wdt_user:wdt_pass@localhost:5432/warehouse_twin
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
QUEUE_TICK_SECONDS=2.0
SIMULATION_SEED=42
SIMULATION_LAMBDA=3.0
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here     # Required when LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite      # Fast model for short commentary
# LLM_COMMENTARY_TIMEOUT_SECONDS=5.0
# LLM_COMMENTARY_MAX_CONCURRENCY=3

# ── LLM Batch Re-Ranking (opt-in, requires LLM_PROVIDER=gemini) ──────
QUEUE_ENGINE_MODE=llm_batch           # "rule_based" (default) | "llm_batch"
LLM_RERANK_TIMEOUT_SECONDS=1.0       # ~50% of QUEUE_TICK_SECONDS
LLM_RERANK_MAX_ORDERS=50             # fallback to rule-based if exceeded

# Firebase Web App configuration for the real-time frontend.
# Copy these into frontend/.env.local; never commit frontend/.env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
