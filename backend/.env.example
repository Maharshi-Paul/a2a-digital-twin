# ==============================================================================
# Warehouse A2A Digital Twin — Backend Environment Configuration
# ==============================================================================

# Database: Local PostgreSQL or Managed Neon / Supabase
# For Neon / managed Postgres, use your connection string.
# Both direct and pooled (PgBouncer) connection strings are supported (statement_cache_size=0).
# Example: postgresql+asyncpg://neondb_owner:npg_secret@ep-cool-1234.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql+asyncpg://wdt_user:wdt_pass@localhost:5432/warehouse_twin
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_STATEMENT_CACHE_SIZE=0

# Redis: Local Redis or Managed Upstash / Render Key Value Store
# For Upstash / Render KV, use rediss:// with TLS token.
# Example: rediss://default:token@cool-fly-1234.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# API & Networking
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000

# CORS & Allowed Origins
# Comma-separated list of allowed frontend origins, or set FRONTEND_URL.
# Vercel preview URLs matching https://*.vercel.app are automatically permitted.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=

# Queue Engine & Simulation
QUEUE_TICK_SECONDS=10.0
QUEUE_ENGINE_MODE=rule_based
QUEUE_ENGINE_IDLE_WHEN_EMPTY=true
SIMULATION_SEED=42
SIMULATION_LAMBDA=3.0

# Optional LLM Features (Default is "none" - runs fully without any API key)
LLM_PROVIDER=none
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
